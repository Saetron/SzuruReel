# SzuruReel Docker Environment Configuration
# Copy this file to .env and adjust variables as needed

# Base URL of your Szurubooru instance (e.g. https://booru.example.com or http://szurubooru:8080)
SZURU_URL=https://booru.example.com

# Multi-User Authentication Note:
# User accounts (username & API token / password) are authenticated dynamically in the WebUI.
# Multiple users can access this instance and sign into their individual Szurubooru accounts.

# Route requests through the container's built-in CORS proxy (true/false)
SZURU_USE_PROXY=true

# Default safety rating for feed: all, safe, sketchy, unsafe
SZURU_DEFAULT_SAFETY=all

# Default reel video audio: false (muted), true (unmuted)
SZURU_AUTOPLAY_SOUND=false

# Default sort order: date-desc, date-asc, score-desc, random
SZURU_DEFAULT_SORT=date-desc

# Web server port
PORT=8080
